    "As posições vêm do OpenStreetMap. O estado da água vem só de relatos da comunidade, com data. O Toret não mede nem garante a água." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positions come from OpenStreetMap. The state of the water comes only from dated community reports. Toret doesn’t measure or guarantee the water."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le posizioni vengono da OpenStreetMap. Lo stato dell’acqua viene solo dalle segnalazioni datate della comunità. Toret non misura né garantisce l’acqua."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As posições vêm do OpenStreetMap. O estado da água vem só de relatos da comunidade, com data. O Toret não mede nem garante a água."
          }
        }
      }
    },
