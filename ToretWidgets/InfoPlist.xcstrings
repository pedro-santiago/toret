            "state" : "translated",
            "value" : "Toret uses your location to show, in the widget, the distance to the nearest fountain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toret usa la tua posizione per mostrare nel widget la distanza dalla fontanella più vicina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Toret usa a sua localização para mostrar, no widget, a distância até a fonte mais próxima."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
